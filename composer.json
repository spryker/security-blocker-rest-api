{
    "name": "spryker/security-blocker-rest-api",
    "type": "library",
    "description": "SecurityBlockerRestApi module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/glossary-storage": "^1.0.0",
        "spryker/glue-application": "^1.81.0",
        "spryker/glue-application-extension": "^1.1.0",
        "spryker/kernel": "^3.77.0",
        "spryker/security-blocker": "^1.5.0",
        "spryker/symfony": "^3.0.0",
        "spryker/transfer": "^3.42.0"
    },
    "require-dev": {
        "spryker/api-platform": "*",
        "spryker/auth-rest-api": "*",
        "spryker/authentication": "*",
        "spryker/code-sniffer": "*",
        "spryker/oauth-backend-api": "*",
        "spryker/testify": "*"
    },
    "suggest": {
        "spryker/api-platform": "If you want to throttle the OAuth `POST /token` endpoints of the API Platform applications."
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerTest\\": "tests/SprykerTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
